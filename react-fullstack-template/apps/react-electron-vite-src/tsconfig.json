{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"noEmit": true,
		"types": [
			"vite/client",
			"node",
			"electron-vite/node",
			"vitest",
			"vitest/browser"
		],
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"paths": {
			"@/*": ["./*"]
		}
	},
	"exclude": ["node_modules"]
}
